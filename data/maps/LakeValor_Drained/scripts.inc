	lock
	faceplayer
	goto_if_set FLAG_DEFEATED_SATURN_LAKE_VALOR, LakeValor_Drained_EventScript_SaturnAfter
	trainerbattle_single TRAINER_COMMANDER_SATURN_VALOR, LakeValor_Drained_Text_SaturnIntro, LakeValor_Drained_Text_SaturnDefeat, LakeValor_Drained_EventScript_SaturnDefeated
