	end

LakeValor_Drained_EventScript_SaturnDefeated::
	setflag FLAG_DEFEATED_SATURN_LAKE_VALOR
	msgbox LakeValor_Drained_Text_SaturnAfter, MSGBOX_DEFAULT
	release
	end

