# JubilifeCity — Platinum-exact layout (Platinum building footprints -> Emerald Rustboro facades)
# Shapes derived from the Platinum layout; tiles are Emerald General + secondary metatiles.
# Legend: T tree . grass , tall grass = path/road ~ water L ledge F fence f flowers : sand P pave
#         S sign K shrub l lamp W walk-in exit; letters = building doors (@stamp); @bldg = stretched facade
@compiler platinum
@name JubilifeCity
@layout LAYOUT_JUBILIFE_CITY
@width 64
@height 64
@style rustboro
@primary gTileset_General
@allow_singles 1
@connection down MAP_ROUTE202 32
@connection right MAP_ROUTE203 0
@connection up MAP_ROUTE204_SOUTH 32
@stamp G MART_RUSTBORO MAP_JUBILIFE_CITY_MART 0
@stamp B PC_RUSTBORO MAP_JUBILIFE_CITY_POKEMON_CENTER_1F 0
@stamp H CIVIC_RUSTBORO MAP_JUBILIFE_CITY_TRAINERS_SCHOOL 0
@warp MAP_ROUTE218_JUBILIFE_GATE 0
@warp MAP_ROUTE218_JUBILIFE_GATE 1
@order MAP_JUBILIFE_CITY_POKETCH_COMPANY
@order MAP_JUBILIFE_TV_1F
@order MAP_JUBILIFE_CITY_CONDO_1F
@order MAP_ROUTE218_JUBILIFE_GATE
@order MAP_ROUTE218_JUBILIFE_GATE
@order MAP_JUBILIFE_CITY_MART
@order MAP_JUBILIFE_CITY_TRAINERS_SCHOOL
