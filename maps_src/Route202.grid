# Route202 — Platinum-exact layout (east edge closed: no Platinum neighbour in our world)
# Shapes derived from the Platinum layout; tiles are Emerald General + secondary metatiles.
# Legend: T tree . grass , tall grass = path/road ~ water L ledge F fence f flowers : sand P pave
#         S sign K shrub l lamp W walk-in exit; letters = building doors (@stamp); @bldg = stretched facade
@compiler platinum
@name Route202
@layout LAYOUT_ROUTE202
@width 32
@height 32
@primary gTileset_General
# Route 202 only uses General (primary) metatiles; Rustboro secondary so the Jubilife
# strip seen from the route is drawn with the right tiles (tileset_consistency_check seam).
@secondary gTileset_Rustboro
@connection up MAP_JUBILIFE_CITY -32
@connection down MAP_SANDGEM_TOWN 0
@sign Route202_EventScript_JubilifeSign
@sign Route202_EventScript_TrainerTips
@sign Route202_EventScript_SandgemSign
@grid
